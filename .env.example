# --- required ---
CONNECTION=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/metacog?retryWrites=true&w=majority
OPENAI_API_KEY=sk-...
PORT=3000

# --- design ---
# cells to randomize between (balanced, sticky per participant id)
ARMS=ai,ai_metacog,control,control_metacog
# which phases show the message: pretest, initial (practice with AI/hints), final (test, no help)
METACOG_PHASES=initial
METACOG_TITLE=Before you start this problem
METACOG_TEXT=This problem is a chance to practice and learn something. We really care about your learning, not only about whether you get the right answer.
# Start button is disabled for this long so the message cannot be clicked through unread
METACOG_MIN_MS=2500
# true = content-free "Start problem" screen in the no-message cells (tighter control, less exact replication)
NEUTRAL_START_SCREEN=false
# true = chat model receives the problem (fixes the bug in the released code); false = Grace's released behaviour
AI_SEES_PROBLEM=true
BLOCK_COPY_PASTE=true
# gpt-5-chat-latest (used in the original study) was shut down by OpenAI on Jul 23, 2026; gpt-5.6-sol is its listed replacement
OPENAI_MODEL=gpt-5.6-sol
# openai = real model; decoy = fixed placeholder reply (no OpenAI calls), for piloting
CHAT_MODE=openai
# DECOY_REPLY=custom placeholder text
# change for every new data collection wave so balancing restarts
STUDY_VERSION=metacog_v1

# --- Prolific ---
PROLIFIC_COMPLETION_CODE=

# --- UCI SONA (from the study's "Client-Side Completion URL") ---
SONA_BASE_URL=https://uci.sona-systems.com
SONA_EXPERIMENT_ID=
SONA_CREDIT_TOKEN=
